<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyName>HshVisionLab</AssemblyName>
    <RootNamespace>HshVisionLab</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="HshDetectionEngin.Face\HshDetectionEngin.Face.csproj" />
    <ProjectReference Include="HshDetectionEngin.Plate\HshDetectionEngin.Plate.csproj" />
    <ProjectReference Include="HshDetectionEngin\HshDetectionEngin.csproj" />
    <ProjectReference Include="HshDetectionEngin.Abstractions\HshDetectionEngin.Abstractions.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
	   <PackageReference Include="Emgu.CV" Version="4.13.0.5924" />	  
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="license.hshlic" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="third_party\mediamtx\mediamtx.exe"
             Link="MediaMTX\mediamtx.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <None Include="HshDetectionEngin.Plate\Models\plate_yolo.onnx"
          Link="Models\Plate\plate_yolo.onnx"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\plate_yolo_fallback.onnx"
          Link="Models\Plate\plate_yolo_fallback.onnx"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\ocr_crnn.onnx"
          Link="Models\Plate\ocr_crnn.onnx"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\ocr_crnn.labels.json"
          Link="Models\Plate\ocr_crnn.labels.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\ocr_crnn.ocr.json"
          Link="Models\Plate\ocr_crnn.ocr.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\ocr_cnn.onnx"
          Link="Models\Plate\ocr_cnn.onnx"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\ocr_cnn.labels.json"
          Link="Models\Plate\ocr_cnn.labels.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\ocr_cnn.ocr.json"
          Link="Models\Plate\ocr_cnn.ocr.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\chars_best_v26.onnx"
          Link="Models\Plate\chars_best_v26.onnx"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\chars_best_v26_int8.onnx"
          Link="Models\Plate\chars_best_v26_int8.onnx"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\chars_best_v26.labels.json"
          Link="Models\Plate\chars_best_v26.labels.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\chars_best_v26.ocr.json"
          Link="Models\Plate\chars_best_v26.ocr.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="HshDetectionEngin.Plate\Models\chars_best_v26_int8.ocr.json"
          Link="Models\Plate\chars_best_v26_int8.ocr.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\MaterialIcons\MaterialIcons-Regular.ttf" LogicalName="HshVisionLab.MaterialIcons.ttf" />
    <Compile Remove="HshDetectionEngin\**\*.cs" />
    <Compile Remove="HshDetectionEngin.Abstractions\**\*.cs" />
    <Compile Remove="HshDetectionEngin.Plate\**\*.cs" />
    <Compile Remove="HshDetectionEngin.Face\**\*.cs" />
    <Compile Remove="HshDetectionEngin.Licensing\**\*.cs" />
    <!-- Old build artifacts can remain after removing the legacy CLI project. -->
    <Compile Remove="HshDetectionEngin.LicenseTool\**\*.cs" />
    <Compile Remove="HshDetectionEngin.LicenseRequest\**\*.cs" />
    <Compile Remove="HshDetectionEngin.LicenseIssuer\**\*.cs" />
    <Compile Remove="HshDetectionEngin.Tools\**\*.cs" />
    <!-- The Windows service is a separate SDK project and must not be included
         by the root project's recursive Compile glob. -->
    <Compile Remove="HshDetectionService\**\*.cs" />
  </ItemGroup>

</Project>
