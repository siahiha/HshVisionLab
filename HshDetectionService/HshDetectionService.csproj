<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseSystemDrawing>true</UseSystemDrawing>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HshDetectionService</AssemblyName>
    <RootNamespace>HshDetectionService</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HshDetectionEngin\HshDetectionEngin.csproj" />
    <ProjectReference Include="..\HshDetectionEngin.Abstractions\HshDetectionEngin.Abstractions.csproj" />
    <ProjectReference Include="..\HshDetectionEngin.Face\HshDetectionEngin.Face.csproj" />
    <ProjectReference Include="..\HshDetectionEngin.Plate\HshDetectionEngin.Plate.csproj" />
    <ProjectReference Include="..\HshDetectionEngin.Licensing\HshDetectionEngin.Licensing.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorcery.VP8" Version="10.0.16" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\third_party\mediamtx\mediamtx.exe"
             Link="MediaMTX\mediamtx.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- Embed the production React manager in the service output when the UI has
       been built. The service then serves the same UI and API from port 5080. -->
  <ItemGroup Condition="Exists('..\DetectionManagerUi\dist\index.html')">
    <Content Include="..\DetectionManagerUi\dist\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
